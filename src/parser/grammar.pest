// Grammar for Entra dynamic group membership rule syntax.
//
// Rules prefixed with '_' are silent (they match but produce no token), '@'
// rules are atomic (no implicit whitespace and no inner tokens) and '$' rules
// are compound-atomic (no implicit whitespace, but inner tokens are kept).

// Entry point - the whole input must be a single segment
MembershipRules = _{ SOI ~ Segment ~ EOI }

// Operands joined by 'and' / 'or'. Brackets recurse into a nested Segment
Segment  = { ( ( Node | Brackets ) ~ Comparator )* ~ ( Node | Brackets ) }
Brackets = _{ "(" ~ Segment ~ ")" }

// A single condition, e.g. 'user.department -eq "Sales"'.
// NOTE: 'Blank' and 'NotOperator' are accepted here but not yet handled by
// the parser
Node = {
    ( Blank | Property ) ~
    ( Blank | Operator | NotOperator ) ~
    ( Blank | Value | Array )
}

// 'user.<name>' or 'device.<name>'
Property = @{ Object ~ "." ~ Variable }
    Object            = { ^"user" | ^"device" }
    Variable          = @{ VariableCharacter* }
    VariableCharacter = { !(WHITESPACE) ~ ANY }


//
// VALUES
//

Value = _{ Boolean | Number | StringWrapper | Null | "(" ~ Value ~ ")" }
Blank = { "*" }

    // Booleans may optionally be quoted
    Boolean = _{ True | False }
        True  = { ^"true"  | ^"\"true\""  }
        False = { ^"false" | ^"\"false\"" }

    // The quotes are silent so the String token is just the contents
    StringWrapper   = _{ "\"" ~ String ~ "\"" }
        String          = @{ StringCharacter* }
        StringCharacter = { !("\"" | "\n") ~ ANY }

    Number = { '0'..'9' }
    Null   = @{ "$"? ~ ^"null" }

Array = {
    "[" ~ "]" |
    "[" ~ Value ~ ("," ~ Value)* ~ "]"
}

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }


//
// OPERATORS
//
// https://learn.microsoft.com/en-gb/entra/identity/users/groups-dynamic-membership
//
// All operators are case-insensitive and the leading '-' is optional
//

OpPrefix = _{ "-" }

// Logical operators joining operands within a Segment
Comparator = _{ And | Or }
    And = @{ OpPrefix? ~ ^"and" }
    Or  = @{ OpPrefix? ~ ^"or"  }

// Comparison operator within a Node
Operator = ${
    OpPrefix? ~
    (
        SingleOp
        | ArrayOp
        | ComparativeOp
        | RegExOp
        | MultiValueOp
        | MathOp
    )
}
NotOperator = { Not? ~ Operator }

// Operators grouped by what they do
SingleOp      = _{ Contains | EndsWith | Equals | NotEndsWith | NotContains | NotEquals | NotStartsWith | StartsWith }
ArrayOp       = _{ In | NotIn }
ComparativeOp = _{ GreaterThanOrEqual | LessThanOrEqual }
RegExOp       = _{ Match | NotMatch }
MultiValueOp  = _{ All | Any }
MathOp        = _{ Add | Subtract }

// Every operator
Add                = @{ OpPrefix? ~ ^"plus" }
All                = @{ OpPrefix? ~ ^"all" }
Any                = @{ OpPrefix? ~ ^"any" }
Contains           = @{ OpPrefix? ~ ^"contains" }
EndsWith           = @{ OpPrefix? ~ ^"endsWith" }
Equals             = @{ OpPrefix? ~ ^"eq" }
GreaterThanOrEqual = @{ OpPrefix? ~ ^"ge" }
In                 = @{ OpPrefix? ~ ^"in" }
LessThanOrEqual    = @{ OpPrefix? ~ ^"le" }
Match              = @{ OpPrefix? ~ ^"match" }
Not                = @{ OpPrefix? ~ ^"not" }
NotContains        = @{ OpPrefix? ~ ^"notContains" }
NotEndsWith        = @{ OpPrefix? ~ ^"notEndsWith" }
NotEquals          = @{ OpPrefix? ~ ^"ne" }
NotIn              = @{ OpPrefix? ~ ^"notIn"  }
NotMatch           = @{ OpPrefix? ~ ^"notMatch"  }
NotStartsWith      = @{ OpPrefix? ~ ^"notStartsWith" }
StartsWith         = @{ OpPrefix? ~ ^"startsWith" }
Subtract           = @{ OpPrefix? ~ ^"minus" }
