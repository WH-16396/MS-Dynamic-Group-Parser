use pest::{Parser, error::Error};
use pest_derive::Parser;
use serde::{Serialize, Deserialize};

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum Syntax<'a> {
    Brackets(Vec<Syntax<'a>>),
    Rule(Vec<Syntax<'a>>),
    Comparator(&'a str),
    Object(&'a str),
    Operator(&'a str),
    String(&'a str),
    Array(Vec<Syntax<'a>>),
    Boolean(bool),
    Null,
}

